      "products": "SAPCloudPlatformIntegration,SAPCloudPlatformIntegrationSuite,Slack",
      "keywords": "Adapter,Adapter for SAP,Integration Suite,SAP Integration Suite,Slack,Slack Adapter,Slack Suite,Suite",
