s10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'EventMeshPOCDhinesh\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"FileToRestPkg","name":"FileToRestPkg","description":"<p>SFTP to REST simple flow</p>","shortText":"SFTP to REST simple flow","version":"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","creationDate":"1764226675899","modifiedDate":"1764226675901","createdBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"9d27fd6aea684440a8f14256bc15ff8d","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'FileToRestPkg\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"GenericIFlowPkg","name":"GenericIFlowPkg","description":"<p>Generic IFlow Package</p>","shortText":"Generic IFlow Package","version":"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","creationDate":"1764259435044","modifiedDate":"1764259435046","createdBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"e531b9da98de4ec6bfa7ee060e544f1a","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'GenericIFlowPkg\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"GooglePubSubAdapterforSAPIntegrationSuite","name":"Google Pub/Sub Adapter for SAP Integration Suite","description":"<p>The GooglePubSub adapter facilitates and accelerates the implementation time of connecting to Google Pub/Sub. The adapter is available only for Standard service plans and above of the SAP Integration Suite. For more information, see SAP Note <a href=\\"https://launchpad.support.sap.com/#/notes/3188446\\" rel=\\"nofollow\\">3188446</a>.</p>\\n<ul>\\n <li>Receiver adapter allows reliable <strong>publishing</strong> of messages to Google Pub/Sub. It offers single message (<strong>Basic</strong>) and multiple message publishing<strong> </strong>(<strong>Advanced</strong>) capabilities.</li>\\n <li>Support for listing Topics with&nbsp;<strong>pagination</strong> using <strong>Page Token.</strong></li>\\n <li>Allows you to modify the acknowledgement deadline of a message using the <strong>Modify Acknowledgement Deadline </strong>operation<strong>.</strong></li>\\n <li>Sender adapter allows&nbsp;<strong>consuming</strong> messages from Google Pub/Sub. You can read messages in real time <strong>(gRPC)</strong> or using a specified polling interval <strong>(REST)</strong>.</li>\\n <li>Provides&nbsp;<strong>multiple post-processing </strong>options: <em>Acknowledge after Successful Processing</em>, <em>Acknowledge Immediately</em>, and <em>Do not Acknowledge</em>.</li>\\n <li>Offers secure authentication via&nbsp;<strong>OAuth2 Service Account </strong>option which uses Key Pair authentication.</li>\\n</ul>\\n<p><strong>Documentation:</strong></p>\\n<p>All documentation, including the User Guide, and Release Notes are included in the documentation tab of this package.</p>\\n<p><strong>Download Location:</strong></p>\\n<p>&nbsp;To install the Adapter, refer to the Adapter Guide located in the Documents tab.</p>","shortText":"This package includes the GooglePubSub Adapter and its documentation. The GooglePubSub adapter is an adapter available on SAP Integration Suite that facilitates message publishing and subscription via Google Pub/Sub.","version":"1.0.0","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"s.ramkumar@sierradigitalinc.com","creationDate":"1746182715596","modifiedDate":"1746182715608","createdBy":"s.ramkumar@sierradigitalinc.com","products":"GoogleCloudPubSub","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"917753da76fe44f5a392e8cf369d0a2c","PartnerContent":false,"UpdateAvailable":true,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'GooglePubSubAdapterforSAPIntegrationSuite\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"HTTPSJSONXMLSFTPPkg","name":"HTTPS_JSON_XML_SFTP Package","description":"<p>HTTPS JSON to XML to SFTP flow</p>","shortText":"HTTPS JSON to XML to SFTP flow","version":"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","creationDate":"1764261302395","modifiedDate":"1764261302397","createdBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"d10ee918fa6945d2ac3fbc062c38311b","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'HTTPSJSONXMLSFTPPkg\')/ScriptCollectionDesigntimeArtifacts"}}},{"i