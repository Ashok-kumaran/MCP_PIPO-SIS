mTags":[],"ResourceId":"a27836fc76184e1da243f75eb44561d1","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'DemoTestMigration\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"DhineshFirstTrial","name":"DhineshFirstTrial","description":"<p></p>","shortText":"Demo Hands-On Training","version":"1.0.0","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"d.malarmani@sierradigitalinc.com","creationDate":"1721297227168","modifiedDate":"1721297227174","createdBy":"d.malarmani@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"5a519a5952f5428e881e84ad009d21f2","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'DhineshFirstTrial\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"DropboxAdapterforSAPIntegrationSuite","name":"Dropbox Adapter for SAP Integration Suite","description":"<p>SAP provides Dropbox adapter allowing users to access all the features supported by Dropbox API. It is available with the standard and premium edition of SAP Integration Suite.The adapter is available only for certain service plans of the SAP Integration Suite. For more information, see SAP Note <a href=\\"https://launchpad.support.sap.com/#/notes/3188446\\" rel=\\"nofollow\\">3188446</a></p>\\n<p><strong>Product Features:</strong></p>\\n<ul>\\n <li>Downloads a file from a Dropbox account.</li>\\n <li>Downloads a folder from the Dropbox account, as a zip file.</li>\\n <li>Copy\'s a file or folder to a different location in the Dropbox.</li>\\n <li>Creates a folder at a given path in the Dropbox account.</li>\\n <li>Deletes the file or folder at a given path.</li>\\n <li>Get\'s a temporary link to stream content of a file.</li>\\n <li>Returns the metadata for a file or folder.</li>\\n <li>Get\'s the space usage information for the current user\'s account.</li>\\n <li>Returns the contents of a folder.</li>\\n <li>Returns revisions for files based on a file path or a file id.</li>\\n <li>Moves a file or folder to a different location in the user\'s Dropbox.</li>\\n <li>Add/update/remove properties associated with the supplied file and templates.</li>\\n <li>Searches for files and folders.</li>\\n <li>Creates a new file with the contents provided in the request.</li>\\n</ul>\\n<p><strong>Key Features:</strong></p>\\n<ul>\\n <li>OAuth based Authorization.</li>\\n <li>Dynamic header and property support in the receiver adapter.</li>\\n <li>Desired response type from Dropbox (JSON/XML).</li>\\n <li>Auto Rename for existing Files/Folders.</li>\\n <li>Post processing file handling.</li>\\n</ul>","shortText":"Dropbox adapter can be used to integrate your Dropbox account with other applications to exchange files.","version":"1.0.6","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"s.ummaka@sierradigitalinc.com","creationDate":"1736777119947","modifiedDate":"1736777119953","createdBy":"s.ummaka@sierradigitalinc.com","products":"Dropbox,SAPCloudPlatformIntegration,SAPCloudPlatformIntegrationSuite","keywords":"Adapter,Adapter for SAP,Dropbox,Dropbox Adapter,Dropbox Suite,Integration Suite,SAP Integration Suite,Suite","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"6e8f2bc0d6654691afcf727224800c95","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'DropboxAdapterforSAPIntegrationSuite\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"EB","name":"EB","description":"<p></p>","shortText":"PC,PI,","version":"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"k.gopalakrishna@sierradigitalinc.com","creationDate":"1750326615588","modifiedDate":"1750326615591","createdBy":"k.gopalakrishna@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"054591e709d34ff29238a731517794d9","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'EB\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"ICAPrepackagedContent","name":"EDI Integration Templates for SAP Integration Advisor","description":"<p>&nbsp;</p>\\n<p>&nbsp;</p>\\n<p>&nbsp;</p>\\n<p>This package provides the required template of inbound and outbound integration flows for the processing of UN/EDIFACT (and UN/EDIFACT subsets-like GS1 EANCOM or Odette EDIFACT), ODETTE, ASC X12 or cXML interchange to SAP IDoc, SAP SOAP or vice versa. These templates only have the necessary steps for processing the B2B data appropriately. Please note that most of these steps are empty and have to be filled with the corresponding runtime artefacts provided by SAP Integration Advisor (IA). Furthermore, it is necessary to define and customize the communication adapters as well as the required information of the interchange envelope and as well as header structures. Following templates of integration flows are available:</p>\\n<p>For inbound direction:</p>\\n<ul>\\n <li><strong>EDI to SAP IDoc - Inbound</strong> - Integration flow template for building inbound EDI (ASC X12, UN/EDIFACT, UN/EDIFACT subsets-like GS1 EANCOM or Odette EDIFACT, ODETTE) to SAP IDoc integration scenarios using SAP IA.</li>\\n <li><strong>EDI to SAP SOAP - Inbound</strong> - Integration flow template for building inbound EDI (ASC X12, UN/EDIFACT, UN/EDIFACT subsets-like GS1 EANCOM or Odette EDIFACT, ODETTE to SAP SOAP integration scenarios using SAP IA.</li>\\n <li><strong>cXML to SAP&nbsp;IDoc - Inbound</strong> - Integration flow template for building inbound cXML to SAP IDoc integration scenarios using SAP IA.</li>\\n <li><strong>B2B XML to SAP IDoc - Inbound</strong>&nbsp;- Integration flow template for building inbound B2B XML to SAP IDoc integration scenarios using SAP IA.</li>\\n <li><strong>TRADACOMS to SAP SOAP or to IDoc - Inbound</strong>&nbsp;- Integration flow template for building inbound TRADACOMS (EDI) to SAP SOAP or IDoc integration scenarios using SAP IA</li>\\n</ul>\\n<p>For outbound direction:</p>\\n<ul>\\n <li><strong>SAP IDoc to EDIFACT - Outbound</strong> - Integration flow template for building outbound SAP IDoc to EDIFACT (including UN/EDIFACT subsets-like GS1 EANCOM or Odette EDIFACT, ODETTE) integration scenarios using SAP IA.</li>\\n <li><strong>SAP IDoc to X12 - Outbound</strong> - Integration flow template for building outbound SAP IDoc to ASC X12 integration scenarios using SAP IA.</li>\\n <li><strong>SAP IDoc to cXML - Outbound</strong> - Integration flow template for building outbound SAP IDoc to cXML integration scenarios using SAP IA.</li>\\n <li><strong>SAP IDoc to B2B XML - Outbound</strong>&nbsp;- Integration flow template for building outbound SAP IDoc to B2B XML integration scenarios using SAP IA.</li>\\n <li><strong>SAP SOAP to&nbsp; EDIFACT - Outbound</strong> - Integration flow template for building outbound SAP SOAP to&nbsp; EDIFACT (including UN/EDIFACT subsets-like GS1 EANCOM or Odette EDIFACT, ODETTE) integration scenarios using SAP IA.</li>\\n <li><strong>SAP SOAP to&nbsp; X12 - Outbound</strong> - Integration flow template for building outbound SAP SOAP to ASC X12 integration scenarios using SAP IA.</li>\\n <li><strong>SAP SOAP or IDoc to TRADACOMS - Outbound</strong>&nbsp;- Integration flow template for building outbound SAP SOAP or IDoc to&nbsp; TRADACOMS integration scenarios using SAP IA.</li>\\n</ul>\\n<p>How to use these templates of integration flows is described in detail in the attached documents, which you will find in the tab \\"Documents\\".</p>\\n<p>&nbsp;</p>\\n<p>&nbsp;</p>\\n<p>&nbsp;</p>","shortText":"Integration flow templates for SAP Integration Advisor (IA) related EDI integration scenarios.","version":"1.0.12","vendor":"SAP","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"n.bandi@sierradigitalinc.com","creationDate":"1724054985079","modifiedDate":"1724054985086","createdBy":"n.bandi@sierradigitalinc.com","products":"SAP ERP,SAPAriba,SAPCloudPlatformIntegrationAdvisor,SAPERP,SAPS4HANA,Third Party,ThirdParty","keywords":"SAP integration Advisor,integration template","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"c79621f7bc8348d89aa2eb2ec6d71143","PartnerContent":false,"UpdateAvailable":true,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'ICAPrepackagedContent\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"EH8ORP","name":"EH8 ORP","description":"<p></p>","shortText":"Connection from EH8 On-Prem System","version":"1.0.0","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"s.ummaka@sierradigitalinc.com","creationDate":"1725889673956","modifiedDate":"1735912786636","createdBy":"d.malarmani@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"13d03d367476464f9d226a900e3f9e14","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'EH8ORP\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"EventMeshPOC","name":"Event_Mesh_POC","description":"<p></p>","shortText":"When there is any change in the Business partner, we need to store the BP data in SFTP server\\n1.\\tWe will trigger an event from S/4 when BP changed \\n2.\\tCPI will call standard BP OData API and place BP data in SFTP server","version":"1.0","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"r.mohan@sierradigitalinc.com","creationDate":"1744724190329","modifiedDate":"1761905599963","createdBy":"k.gopalakrishna@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"4f82f0d3e0d04c0397e7729393411561","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'EventMeshPOC\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"EventMeshPOCDhinesh","name":"Event Mesh POC - Dhinesh","description":"<p></p>","shortText":"Event Mesh Concepts POC","version":"1.0.0","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"d.malarmani@sierradigitalinc.com","creationDate":"1729152771362","modifiedDate":"1729858834948","createdBy":"d.malarmani@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"094114ac6b1949deb656a61e9d0d81d2","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'EventMeshPOCDhinesh\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"GooglePubSubAdapterforSAPIntegrationSuite","name":"Google Pub/Sub Adapter for SAP Integration Suite","description":"<p>The GooglePubSub adapter facilitates and accelerates the implementation time of connecting to Google Pub/Sub. The adapter is available only for Standard service plans and above of the SAP Integration Suite. For more information, see SAP Note <a href=\\"https://launchpad.support.sap.com/#/notes/3188446\\" rel=\\"nofollow\\">3188446</a>.</p>\\n<ul>\\n <li>Receiver adapter allows reliable <strong>publishing</strong> of messages to Google Pub/Sub. It offers single message (<strong>Basic</strong>) and multiple message publishing<strong> </strong>(<strong>Advanced</strong>) capabilities.</li>\\n <li>Support for listing Topics with&nbsp;<strong>pagination</strong> using <strong>Page Token.</strong></li>\\n <li>Allows you to modify the acknowledgement deadline of a message using the <strong>Modify Acknowledgement Deadline </strong>operation<strong>.</strong></li>\\n <li>Sender adapter allows&nbsp;<strong>consuming</strong> messages from Google Pub/Sub. You can read messages in real time <strong>(gRPC)</strong> or using a specified polling interval <strong>(REST)</strong>.</li>\\n <li>Provides&nbsp;<strong>multiple post-processing </strong>options: <em>Acknowledge after Successful Processing</em>, <em>Acknowledge Immediately</em>, and <em>Do not Acknowledge</em>.</li>\\n <li>Offers secure authentication via&nbsp;<strong>OAuth2 Service Account </strong>option which uses Key Pair authentication.</li>\\n</ul>\\n<p><strong>Documentation:</strong></p>\\n<p>All documentation, including the User Guide, and Release Notes are included in the documentation tab of this package.</p>\\n<p><strong>Download Location:</strong></p>\\n<p>&nbsp;To install the Adapter, refer to the Adapter Guide located in the Documents tab.</p>","shortText":"This package includes the GooglePubSub Adapter and its documentation. The GooglePubSub adapter is an adapter available on SAP Integration Suite that facilitates message publishing and subscription via Google Pub/Sub.","version":"1.0.0","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"s.ramkumar@sierradigitalinc.com","creationDate":"1746182715596","modifiedDate":"1746182715608","createdBy":"s.ramkumar@sierradigitalinc.com","products":"GoogleCloudPubSub","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"917753da76fe44f5a392e8cf369d0a2c","PartnerContent":false,"UpdateAvailable":true,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'GooglePubSubAdapterforSAPIntegrationSuite\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"IntegrationSuiteAlertingFrameworkusingAlertNotificationService","name":"Integration Suite Alerting Framework using SAP BTP Alert Notification Service","description":"<p>This package contains multiple iflows designed to extract and send cloud integration events to SAP BTP Alert Notification Service as below<br><br>\\n 1 - Send Events to ANS<br>\\n 2 - Send Cloud Integration Error iflows events to ANS<br>\\n 3 - Send Cloud Integration Error Messages events to ANS<br>\\n 4 - Send Cloud Integration JMS events to ANS<br>\\n 5 - Send Cloud Integration Expiring Certificates events to ANS<br>\\n 6 - Send Explicit (Exception/Notification) Events to ANS<br><br><br>\\n More information on <a href=\\"https://help.sap.com/docs/alert-notification/sap-alert-notification-for-sap-btp/what-is-sap-alert-notification-service-for-sap-btp?locale=en-US\\" rel=\\"nofollow\\">SAP Alert Notification Service for SAP BTP </a></p>","shortText":"This package includes various iflows to relay events on message failures, erroring iflows, expiring/expired certificates, JMS queue issues, etc., by utilizing Message Processing Log APIs to send notifications through SAP BTP Alert Notification Service.","version":"1.0.0","vendor":"SAP","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"s.shaik@sierradigitalinc.com","creationDate":"1747220587999","modifiedDate":"1747220588005","createdBy":"s.shaik@sierradigitalinc.com","products":"SAPCloudPlatformAlertNotification,SAPCloudPlatformIntegration","keywords":"","countries":"","industries":"","lineOfBusiness":"Technology Area Enterprise Technology","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"d7280ee40b144404b62ae2dfe81bbe19","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'IntegrationSuiteAlertingFrameworkusingAlertNotificationService\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"INVOIC02TOINVOIC96Amigration","name":"INVOIC02_TO_INVOIC96A_migration","description":"<p></p>","shortText":"Migrating PIPO interface to CPI","version":"1.0.1","vendor":"SAP","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"s.shaik@sierradigitalinc.com","creationDate":"1760437783395","modifiedDate":"1760437783398","createdBy":"s.shaik@sierradigitalinc.com","pr