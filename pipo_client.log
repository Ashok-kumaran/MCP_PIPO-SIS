 value="2"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="SNDPRN">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Partner Number of Sender</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:maxLength value="10"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="SNDSAD" minOccurs="0">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Sender address (SADR)</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:maxLength value="21"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="SNDLAD" minOccurs="0">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Logical address of sender</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:maxLength value="70"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="RCVPOR">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Receiver port</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:maxLength value="10"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="RCVPRT" minOccurs="0">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Partner Type of Receiver</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="