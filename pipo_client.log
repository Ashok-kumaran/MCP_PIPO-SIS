onDate":"1764340241866","modifiedDate":"1764340241867","createdBy":"mohammedsamsuthin.k@smartsoftus.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"e81d74ddb5a04dc3aa9a0bb11d102687","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'MSMuleSoftMigration\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"NaveenPOCTrail","name":"Naveen_POC_Trail","description":"<p></p>","shortText":"Developing POC\'S Using Different scenerios.","version":"1.0","vendor":"Sierra","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"n.bandi@sierradigitalinc.com","creationDate":"1723017313809","modifiedDate":"1723017313812","createdBy":"n.bandi@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"2de5e85014cc405ab8d5b8583541bfce","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'NaveenPOCTrail\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"NetSuiteAdapterforSAPIntegrationSuite","name":"NetSuite Adapter for SAP Integration Suite","description":"<p><span style=\\"font-size: 14pt\\"><span style=\\"font-size: 12pt\\">The NetSuite adapter facilitates and accelerates the implementation time of connecting to NetSuite. The adapter is available only for Standard service plans and above of the SAP Integration Suite. For more information, see SAP Note <a href=\\"https://launchpad.support.sap.com/#/notes/3188446\\" rel=\\"nofollow\\">3188446</a>.</span>&nbsp;</span></p>\\n<p><strong>Feature highlights:</strong></p>\\n<ul>\\n <li style=\\"text-align: left\\"><strong>Support for multiple API versions</strong>: NetSuite supports multiple API versions with an editable API version field enabling users to input the latest supported version.</li>\\n <li style=\\"text-align: left\\"><strong>Secure authentication based on Tokens</strong>: The NetSuite adapter supports the Token-Based Authentication (TBA) mechanism which increases overall system security. Every call between NetSuite and SAP Cloud Integration is secured by Tokens.</li>\\n <li style=\\"text-align: left\\"><strong>Support for multiple NetSuite operations</strong>: The NetSuite adapter supports various operations like Add, Attach, Add List, Get, Get List, Delete, Get All, Get Saved Search, Async Add List, Update, Update List, Upsert List, etc.</li>\\n <li style=\\"text-align: left\\"><strong>Querying and searching</strong>: In addition to all the operations that the NetSuite Adapter offers, the Adapter allows the querying of data from your NetSuite tenant.</li>\\n <li style=\\"text-align: left\\"><strong>Dynamic configuration with headers and properties</strong>: Assigning dynamic values to different properties allows enhanced flexibility to your integration flows. You can also refer to dynamic parameters using SAP Cloud Integration exchange headers and properties.&nbsp;</li>\\n <li style=\\"text-align: left\\"><strong>Processing more than one record at a time</strong>: Some operations can be performed on one or more new instances of a record in NetSuite. In most cases, these operations contain the word List in them. As an example, the addlist operation can be used to add one or more new instances of a record to NetSuite.</li>\\n <li style=\\"text-align: left\\"><strong>Processing more than one record of data asynchronously</strong>: Some operations can be performed on one or more new instances of a record in NetSuite in an asynchronous manner. In general, for asynchronous operations, bulk records are sent to NetSuite without the need to wait for a response.</li>\\n <li style=\\"text-align: left\\"><strong>XSD Generator</strong>: To help speed up the integration, an XSD generator in the form of an Eclipse Plug-in is provided alongside the adapter. With this Eclipse Plug-in/Workbench, it is possible to generate an XSD which includes the structure of an Account Record. The generated XSD can then be imported into Cloud Integration and used for mapping purposes.</li>\\n <li style=\\"text-align: left\\"><strong>Full integration support for Custom Records and Fields</strong>: In addition to supporting all the standard NetSuite Records (or entities), the Adapter integrates with all the Custom Objects in NetSuite, providing support for custom fields in the objects as well.</li>\\n</ul>\\n<p><strong>Documentation:</strong></p>\\n<p>All documentation, including the User Guide, and Release Notes are included in the documentation tab of this package.</p>\\n<p><strong>Download Location:</strong></p>\\n<p>To download the SAP NetSuite Adapter\'s Eclipse Plug-In or Workbench, navigate to:&nbsp;<a href=\\"https://launchpad.support.sap.com/#/softwarecenter\\" rel=\\"nofollow\\">https://launchpad.support.sap.com/#/softwarecenter</a>&nbsp;&gt;&gt; SUPPORT PACKAGES &amp; PATCHES By Alphabetical Index (A-Z) &gt;&gt;&nbsp;C &gt;&gt;&nbsp;look for “<strong>SAP CP IS ADAPTER ADVANCE PACK</strong>”.</p>\\n<p>Alternatively, you can directly go to:</p>\\n<ul>\\n <li><a href=\\"https://eur03.safelinks.protection.outlook.com/?url=https%3A%2F%2Flaunchpad.support.sap.com%2F%23%2Fsoftwarecenter%2Ftemplate%2Fproducts%2F_APP%3D00200682500000001943%26_EVENT%3DNEXT%26HEADER%3DY%26FUNCTIONBAR%3DY%26EVENT%3DTREE%26NE%3DNAVIGATE%26ENR%3D73555000100800003071%26V%3DMAINT%26TA%3DACTUAL%2FSAP%2520CP%2520IS%2520ADAPTER%2520ADVANCE%2520PACK&amp;data=04%7C01%7Cjohn.bilay%40rojoconsultancy.com%7C514b303c7b6a4903e49708d8a0d0c4f2%7C920d0ff2113441eca952e6c5ca6532c1%7C0%7C0%7C637436165801744392%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C1000&amp;sdata=hr4z9GRGDN1%2FhvvE1i%2FmyqbGhUotS5hK%2BjtuBPejytw%3D&amp;reserved=0\\" rel=\\"nofollow\\">SAP CP IS ADAPTER ADVANCE PACK</a></li>\\n</ul>\\n<p>Please note that the content of the package is the Eclipse Plug-In or Workbench. To install the Adapter, refer to the Adapter Guide located in the Documents tab.</p>","shortText":"This package include the NetSuite Adapter and its documentation. The NetSuite adapter facilitates and accelerates the implementation time of connecting to NetSuite.","version":"1.0.0","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"d.malarmani@sierradigitalinc.com","creationDate":"1724748544004","modifiedDate":"1724748544013","createdBy":"d.malarmani@sierradigitalinc.com","products":"NetSuite,SAPCloudPlatformIntegrationSuite","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"96a5fe6d864a4704a2b788377fc5ad86","PartnerContent":false,"UpdateAvailable":true,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'NetSuiteAdapterforSAPIntegrationSuite\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"nihademomigration","name":"niha_demo_migration","description":"<p></p>","shortText":"demo_migration","version":"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"d.malarmani@sierradigitalinc.com","creationDate":"1728393963087","modifiedDate":"1728393963091","createdBy":"d.malarmani@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"b499d45069d2445197fe0cf6046cad78","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'nihademomigration\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"nihapocflows","name":"niha_poc flows","description":"<p></p>","shortText":"poc flow","version":"1.0.0","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"n.ashrafali@sierradigitalinc.com","creationDate":"1738923356980","modifiedDate":"1743517309213","createdBy":"n.ashrafali@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"ddda401dee34473ab9774089f054945c","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'nihapocflows\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"OpenAIChatGPTPurchaseOrderNotification","name":"OpenAI ChatGPT Integration with SAP S/4HANA and Microsoft","description":"<p>This interface reads an email inbox that is receiving requisition from customers that wants to know the overall status of the purchase order. After reading the email, it sends the mail body to OpenAI ChatGPT so it recognizes what is the Purchase Order number. With this value, the IFlow then captures the overall status from SAP S/4HANA using API and replies to the customer with this information, using OpenAI ChatGPT to build a meaningful email.</p>\\n<p>It contains 1 Integration Flow (IFlow) and 1 Value Mapping.</p>\\n<ul>\\n <li>OpenAI ChatGPT with SAP S/4HANA PurchaseOrder Status Notification &nbsp;– The main interface that captures the mail body, integrates with OpenAI ChatGPT and SAP S/4HANA and then replies to the email with the overall status.</li>\\n <li>OpenAI Status Description Value Mappings – This value mapping contains all possible status codes and status descriptions from SAP S/4HANA.</li>\\n</ul>","shortText":"This integration package reads an email inbox for customers who require assistance with the delivery status of a specific purchasing document and uses OpenAI ChatGPT to build meaningful emails as a response to the customer.","version":"1.0.0","vendor":"Crave InfoTech","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"p.karthikeyan@sierradigitalinc.com","creationDate":"1739355740716","modifiedDate":"1739355740732","createdBy":"p.karthikeyan@sierradigitalinc.com","products":"ChatGPT,CraveInfotech,Google,MicrosoftOutlook,SAP S/4HANA","keywords":"ChatGPT,Microsoft,S/4HANA","countries":"USA","industries":"","lineOfBusiness":"Technology Area Enterprise Technology","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"5a1a946ace074fff80f9b35cd40e5463","PartnerContent":true,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'OpenAIChatGPTPurchaseOrderNotification\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"ORP","name":"ORP - HESS","description":"<p></p>","shortText":"Owner Relation Portal for HESS Environment","version":"1.0","vendor":"Sierra Digital Inc","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"d.malarmani@sierradigitalinc.com","creationDate":"1707848670028","modifiedDate":"1734961274968","createdBy":"d.malarmani@sierradigitalinc.com","products