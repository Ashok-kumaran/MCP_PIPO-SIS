tform":"Cloud Integration","modifiedBy":"d.malarmani@sierradigitalinc.com","creationDate":"1737641503517","modifiedDate":"1739527245060","createdBy":"d.malarmani@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"9f7fb4ff91514064a9c9037c4e56a815","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'BusinessPartnerPortal\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"CDOTES4HANA","name":"CDOTE - S4 HANA","description":"<p></p>","shortText":"Commodity Derivates Order and Trade Execution","version":"1.0.0","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"r.mohan@sierradigitalinc.com","creationDate":"1741094136576","modifiedDate":"1751882981676","createdBy":"d.malarmani@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"a2b21f3e150f417c92ad1c8ff53e206d","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'CDOTES4HANA\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"CloudIntegrationTradingPartnerManagementV2","name":"Cloud Integration - Trading Partner Management V2","description":"<p>Master Integration Package covering the generic flows for \\"Cloud Integration - Trading Partner Management V2\\".</p>\\n<p>It contains the script collections and integration flows needed for processing messages between B2B partners dynamically based on configurations done in Trading Partner Management</p>","shortText":"Master Integration Package covering the generic flows for \\"Cloud Integration - Trading Partner Management V2\\".","version":"2.3.2","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"k.gopalakrishna@sierradigitalinc.com","creationDate":"1725548565741","modifiedDate":"1725548565748","createdBy":"k.gopalakrishna@sierradigitalinc.com","products":"SAPCloudPlatformIntegration,ThirdParty","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"66a54a5a69344daab6cafc8a8d35805f","PartnerContent":false,"UpdateAvailable":true,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'CloudIntegrationTradingPartnerManagementV2\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"CoupaAdapterforSAPIntegrationSuite","name":"Coupa Adapter for SAP Integration Suite","description":"<p><span style=\\"font-size: 14pt\\"><span style=\\"font-size: 12pt\\">The Coupa adapter facilitates and accelerates the implementation time of connecting to Coupa. The adapter is available only for Standard service plans and above of the SAP Integration Suite. For more information, see SAP Note <a href=\\"https://launchpad.support.sap.com/#/notes/3188446\\" rel=\\"nofollow\\">3188446</a>.</span>&nbsp;</span></p>\\n<p><span style=\\"font-size: 14pt\\"><strong>Feature highlights:</strong></span></p>\\n<ul>\\n <li><strong>Secure authentication with OAuth 2.0:</strong> Connecting Coupa with other applications is securely achieved by employing OAuth 2.0 authentication process. Every REST call between Coupa and SAP Cloud Integration is secured by specific authorization flows.</li>\\n <li><strong>Supports all Coupa operations</strong>: Our Adapter has support for all Coupa operations including Create, Get , Modify, Query, and Update Resource operations.</li>\\n <li><strong>Auto Pagination</strong>: You can query efficiently with our integrated pagination support. Coupa adapter supports querying of all records of a resource using Auto Pagination.</li>\\n <li><strong>Dynamic configuration with headers and properties</strong>: Assigning dynamic values to different properties allows enhanced flexibility to your integration flows. You can also refer to dynamic parameters using SAP Cloud Integration exchange headers and properties.&nbsp;</li>\\n <li><strong>Support for XML &amp; JSON</strong>: Coupa Adapter extends support for multiple payload formats. XML and JSON are fully incorporated throughout the adapter.</li>\\n <li><strong>Coupa Eclipse plug-in</strong>: The Eclipse plug-in helps to generate all necessary up-to-date message XSDs for specific resources and the custom objects in the Coupa.</li>\\n <li><strong>Full integration support for Custom Objects and Fields</strong>: In addition to support for every standard Coupa resource, the adapter also integrates with all custom objects in Coupa.&nbsp;</li>\\n</ul>\\n<p><span style=\\"font-size: 14pt\\"><strong>Documentation:</strong></span></p>\\n<p>All documentation, including the Installation Guide, User Guide, and Release Notes are included in the documentation tab of this package.</p>\\n<p><span style=\\"font-size: 14pt\\"><strong>Download Location:</strong></span></p>\\n<p>To download the SAP Coupa Adapter\'s Eclipse Plug-In or Workbench, navigate to:&nbsp;<a href=\\"https://launchpad.support.sap.com/#/softwarecenter\\" rel=\\"nofollow\\">https://launchpad.support.sap.com/#/softwarecenter</a>&nbsp;&gt;&gt; SUPPORT PACKAGES &amp; PATCHES By Alphabetical Index (A-Z) &gt;&gt;&nbsp;C &gt;&gt;&nbsp;look for “<strong>SAP CP IS ADAPTER ADVANCE PACK</strong>”.</p>\\n<p>Alternatively, you can directly go to:</p>\\n<ul>\\n <li><a href=\\"https://eur03.safelinks.protection.outlook.com/?url=https%3A%2F%2Flaunchpad.support.sap.com%2F%23%2Fsoftwarecenter%2Ftemplate%2Fproducts%2F_APP%3D00200682500000001943%26_EVENT%3DNEXT%26HEADER%3DY%26FUNCTIONBAR%3DY%26EVENT%3DTREE%26NE%3DNAVIGATE%26ENR%3D73555000100800003071%26V%3DMAINT%26TA%3DACTUAL%2FSAP%2520CP%2520IS%2520ADAPTER%2520ADVANCE%2520PACK&amp;data=04%7C01%7Cjohn.bilay%40rojoconsultancy.com%7C514b303c7b6a4903e49708d8a0d0c4f2%7C920d0ff2113441eca952e6c5ca6532c1%7C0%7C0%7C637436165801744392%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C1000&amp;sdata=hr4z9GRGDN1%2FhvvE1i%2FmyqbGhUotS5hK%2BjtuBPejytw%3D&amp;reserved=0\\" rel=\\"nofollow\\">SAP CP IS ADAPTER ADVANCE PACK</a></li>\\n</ul>\\n<p>Please note that the content of the package is the Eclipse Plug-In or Workbench. To install the Adapter, refer to the Adapter Installation Guide located in the Documents tab.</p>","shortText":"This package include the Coupa Adapter and its documentation. The Coupa adapter facilitates and accelerates the implementation time of connecting to Coupa.","version":"1.0.2","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"n.ashrafali@sierradigitalinc.com","creationDate":"1744293532006","modifiedDate":"1744293532011","createdBy":"n.ashrafali@sierradigitalinc.com","products":"Coupa","keywords":"","countries":"","industries":"","lineOfBusiness":"Sourcing and Procurement","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"03cd6050185348f9b6a396555984fde4","PartnerContent":false,"UpdateAvailable":true,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'CoupaAdapterforSAPIntegrationSuite\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"CPIPMR","name":"CPI_Ragul",