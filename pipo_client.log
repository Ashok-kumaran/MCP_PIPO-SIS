th value="2"/>\r\n               </xsd:restriction>\r\n              </xsd:simpleType>\r\n             </xsd:element>\r\n             <xsd:element name="PLANR" minOccurs="0">\r\n              <xsd:annotation>\r\n               <xsd:documentation>Planning segment number</xsd:documentation>\r\n              </xsd:annotation>\r\n              <xsd:simpleType>\r\n               <xsd:restriction base="xsd:string">\r\n                <xsd:maxLength value="20"/>\r\n               </xsd:restriction>\r\n              </xsd:simpleType>\r\n             </xsd:element>\r\n             <xsd:element name="KDAUF" minOccurs="0">\r\n              <xsd:annotation>\r\n               <xsd:documentation>Sales Order Number</xsd:documentation>\r\n              </xsd:annotation>\r\n              <xsd:simpleType>\r\n               <xsd:restriction base="xsd:string">\r\n                <xsd:maxLength value="10"/>\r\n               </xsd:restriction>\r\n              </xsd:simpleType>\r\n             </xsd:element>\r\n             <xsd:element name="KDPOS" minOccurs="0">\r\n              <xsd:annotation>\r\n               <xsd:documentation>Item Number in Sales Order</xsd:documentation>\r\n              </xsd:annotation>\r\n              <xsd:simpleType>\r\n               <xsd:restriction base="xsd:string">\r\n                <xsd:pattern value="\\d+"/>\r\n                <xsd:maxLength value="6"/>\r\n               </xsd:restriction>\r\n              </xsd:simpleType>\r\n             </xsd:element>\r\n             <xsd:element name="LGORT" minOccurs="0">\r\n              <xsd:annotation>\r\n               <xsd:documentation>Storage Location</xsd:documentation>\r\n              </xsd:annotation>\r\n              <xsd:simpleType>\r\n               <xsd:restriction base="xsd:string">\r\n                <xsd:maxLength value="4"/>\r\n               </xsd:restriction>\r\n              </xsd:simpleType>\r\n             </xsd:element>\r\n             <xsd:element name="PSPEL" minOccurs="0">\r\n      