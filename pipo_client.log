"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"k.gopalakrishna@sierradigitalinc.com","creationDate":"1724235615373","modifiedDate":"1724235615375","createdBy":"k.gopalakrishna@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"23015df73a1e4c60a53bbd6b50d76230","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'POCMigration\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"POMigrationUseCase","name":"PO_Migration_Use Case","description":"<p></p>","shortText":"PO objects test Creation","version":"1.0.0","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"s.ummaka@sierradigitalinc.com","creationDate":"1721400739445","modifiedDate":"1721401104199","createdBy":"s.ummaka@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"e149c7f8f7b645e79e3180b15250a5aa","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'POMigrationUseCase\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"POtoCPIMigration","name":"PO_to_CPI_Migration","description":"<p></p>","shortText":"We are migrating Data from PO system to CPI.","version":"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"s.ummaka@sierradigitalinc.com","creationDate":"1722257790430","modifiedDate":"1722257790433","createdBy":"s.ummaka@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"8c77b7a1a4234c60a390fa458efa5afa","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'POtoCPIMigration\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"POtoCPImigration","name":"PO_to_CPI_migration","description":"<p></p>","shortText":"migration assessment","version":"1.0.1","vendor":"SAP","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"s.shaik@sierradigitalinc.com","creationDate":"1759832978598","modifiedDate":"1759832978601","createdBy":"s.shaik@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"c5d305b38be440c8bf8d502aa9fada8e","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'POtoCPImigration\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"ReplaymessagesfromQueuesviaSAPEventMesh","name":"Replay Messages from Queues via SAP Event Mesh","description":"<p>This package contains three integration flows:</p>\\n<ol>\\n <li>Retrieves the messages from SAP Event Mesh using AMQP Adapter and pushes the messages into a JMS Queue.</li>\\n <li>Picks up the message in the JMS Queues and forwards it to the respective receiver endpoint using ProcessDirect.</li>\\n <li>ProcessDirect integration flow that processes the message to the relevant receiver.</li>\\n</ol>\\n<p>It also includes a Value Mapping that maps the message from a JMS Queue to the correct ProcessDirect Endpoint.</p>","shortText":"This package provides a replay mechanism for SAP Event Mesh messages.","version":"1.0.0","vendor":"SAP","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"d.malarmani@sierradigitalinc.com","creationDate":"1729950198279","modifiedDate":"1729950198288","createdBy":"d.malarmani@sierradigitalinc.com","products":"SAPCloudPlatformIntegration,SAPEventMesh,ThirdParty","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"eae381148d274040af56f453c86546ca","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'ReplaymessagesfromQueuesviaSAPEventMesh\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"RestToJMS","name":"REST to JMS","description":"<p>Receive REST payload and push to JMS queue</p>","shortText":"Receive REST payload and push to JMS queue","version":"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","creationDate":"1764163326121","modifiedDate":"1764163326126","createdBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"b7ea6ac3da4b4cd0a5bce504897c6c6a","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'RestToJMS\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"SalesforceAdapter","name":"Salesforce Adapter for SAP Integration Suite","description":"<p>SAP provides a Salesforce adapter. It is included with any license of SAP Cloud Integration and SAP Integration Suite.</p>\\n<p><strong>Feature highlights:</strong></p>\\n<ul>\\n<li>Supports subscription to Salesforce events, including PushTopic Events, Generic Events, Platform Events, and Change Data Capture Events.</li>\\n<li>Supports scheduled batch processing of PushTopic Events, Generic Events, Platform Events, and Change Data Capture Events via Event Processing.</li>\\n<li>Supports multiple\u202fSalesforce API versions.</li>\\n<li>Supports over 50 operations, including Create, Read, Update, and Delete (CRUD).</li>\\n<li>Supports Apex Call operations.</li>\\n<li>Supports both REST Bulk and REST Bulk 2.0.</li>\\n<li>Support for Salesforce Custom Objects and Fields.</li>\\n<li>Support for CRUD operations on Composite and Collection Salesforce Object structures.</li>\\n<li>Supports nested structures in the CRUD operations.</li>\\n<li>Supports SOQL and SOSL queries.&nbsp;</li>\\n<li>Secure authentication with OAuth 2.0.</li>\\n<li>Support for JWT authentication.</li>\\n<li>Supports dynamic configuration with headers and properties.</li>\\n<li>Support for XML and JSON formats.</li>\\n<li>XSD generation: the adapter comes equipped with an Eclipse Plug-in which helps you generate&nbsp;all&nbsp;necessary up-to-date messages XSD&rsquo;s for your specific Salesforce version and custom objects.</li>\\n<li>SOQL and SOSL Query generation using Eclipse&nbsp;plugin.</li>\\n<li>Support for REST Custom Request operation.</li>\\n</ul>\\n<p><strong>Documentation:</strong></p>\\n<p>All documentation, including Installation Guide, User Guide, and Release Notes are included in the ZIP file downloaded from SAP Software Download Center (See Download Location section).</p>\\n<p>The Changelog can be found in the documentation tab of this package.</p>\\n<p><strong>Download Location:</strong></p>\\n<p>Navigate to:</p>\\n<p><span style=\\"font-size: 10.5pt ; line-height: 105%\\"><a style=\\"color: #0563c1 ; text-decoration: underline\\" href=\\"https://eur03.safelinks.protection.outlook.com/?url=https%3A%2F%2Flaunchpad.support.sap.com%2F%23%2Fsoftwarecenter&amp;data=04%7C01%7Cjohn.bilay%40rojoconsultancy.com%7C514b303c7b6a4903e49708d8a0d0c4f2%7C920d0ff2113441eca952e6c5ca6532c1%7C0%7C0%7C637436165801744392%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C1000&amp;sdata=Y%2BR%2BBOxBxWtDj%2FpkYR2nJddu6h4nv9lru4Gty58X34k%3D&amp;reserved=0\\" rel=\\"nofollow\\">https://launchpad.support.sap.com/#/softwarecenter</a> &gt;&gt;</span><span style=\\"font-size: 10.5pt ; line-height: 105%\\"> SUPPORT PACKAGES &amp; PATCHES &gt;&gt;</span><span style=\\"font-size: 10.5pt ; line-height: 105%\\">&nbsp;By Alphabetical Index (A-Z) &gt;&gt;</span><span style=\\"font-size: 10.5pt ; line-height: 105%\\"> C &gt;&gt;</span><span style=\\"font-size: 10.5pt ; line-height: 105%\\">&nbsp;look for &ldquo;<strong>SAP CP IS ADAPTER ADVANCE PACK</strong>&rdquo; &amp; &ldquo;<strong>SAP CP IS ADAPTER BASE PACK</strong>&rdquo; </span></p>\\n<p>Alternatively, you can directly go to:</p>\\n<ul>\\n<li style=\\"text-align: left\\"><span style=\\"font-size: 10.5pt ; color: #333333\\"><a style=\\"color: #0563c1 ; text-decoration: underline\\" href=\\"https://eur03.safelinks.protection.outlook.com/?url=https%3A%2F%2Flaunchpad.support.sap.com%2F%23%2Fsoftwarecenter%2Ftemplate%2Fproducts%2F_APP%3D00200682500000001943%26_EVENT%3DNEXT%26HEADER%3DY%26FUNCTIONBAR%3DY%26EVENT%3DTREE%26NE%3DNAVIGATE%26ENR%3D73555000100800003071%26V%3DMAINT%26TA%3DACTUAL%2FSAP%2520CP%2520IS%2520ADAPTER%2520ADVANCE%2520PACK&amp;data=04%7C01%7Cjohn.bilay%40rojoconsultancy.com%7C514b303c7b6a4903e49708d8a0d0c4f2%7C920d0ff2113441eca952e6c5ca6532c1%7C0%7C0%7C637436165801744392%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C1000&amp;sdata=hr4z9GRGDN1%2FhvvE1i%2FmyqbGhUotS5hK%2BjtuBPejytw%3D&amp;reserved=0\\" rel=\\"nofollow\\">SAP CP IS ADAPTER ADVANCE PACK</a></span></li>\\n<li style=\\"text-align: left\\"><span style=\\"color: black\\"><a style=\\"color: #0563c1 ; text-decoration: underline\\" href=\\"https://eur03.safelinks.protection.outlook.com/?url=https%3A%2F%2Flaunchpad.support.sap.com%2F%23%2Fsoftwarecenter%2Ftemplate%2Fproducts%2F_APP%3D00200682500000001943%26_EVENT%3DNEXT%26HEADER%3DY%26FUNCTIONBAR%3DY%26EVENT%3DTREE%26NE%3DNAVIGATE%26ENR%3D73554900100800003671%26V%3DMAINT%26TA%3DACTUAL%2FSAP%2520CP%2520IS%2520ADAPTER%2520BASE%2520PACK&amp;data=04%7C01%7Cjohn.bilay%40rojoconsultancy.com%7C514b303c7b6a4903e49708d8a0d0c4f2%7C920d0ff2113441eca952e6c5ca6532c1%7C0%7C0%7C637436165801754381%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C1000&amp;sdata=INMqTPPETV65mV%2BOSCehentybcbT3nA9VNLETRTZmak%3D&amp;reserved=0\\" rel=\\"nofollow\\">SAP CP IS ADAPTER BASE PACK</a></span></li>\\n</ul>","shortText":"The Salesforce Adapter facilitates and accelerates the implementation time of connecting to Salesforce.\\nIt provides features that reduce the complexity of discovering Salesforce entities and their properties.","version":"1.1.0","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"r.mohan@sierradigitalinc.com","creationDate":"1748598698558","modifiedDate":"1748598698562","createdBy":"r.mohan@sierradigitalinc.com","products":"SAPCloudPlatformIntegration,SAPCloudPlatformIntegrationSuite,Salesforce","keywords":"CRM,Customer relationship management,OEM,Salesforce","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"04f2892fed894e338944cf49a530a0e3","PartnerContent":false,"UpdateAvailable":true,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'SalesforceAdapter\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"SalesforcePubSubAdapterforSAPIntegrationSuite","name":"Salesforce Pub/Sub Adapter for SAP Integration Suite","description":"<p>The SalesforcePubSub adapter facilitates and accelerates the implementation time of connecting to Salesforce Pub/Sub API. The adapter is available only for Standard service plans and above of the SAP Integration Suite. For more information, see SAP Note <a href=\\"https://launchpad.support.sap.com/#/notes/3188446\\" rel=\\"nofollow\\">3188446</a>.</p>\\n<ul>\\n <li>Allows you to <strong>subscribe</strong> to the channels to receive events.</li>\\n <li>Supports&nbsp;<strong>publishing</strong> of events to channels with defined schemas.</li>\\n <li>Retrieves schema from the Salesforce channel using the&nbsp;<strong>Get Schema</strong> operation.</li>\\n <li>Offers secure authentication options using&nbsp;<strong>OAuth 2.0 Username-Password</strong> and <strong>OAuth 2.0 JWT Bearer</strong>.</li>\\n <li>Using the Sender Adapter, you can retrieve events from a&nbsp;<strong>specific position (Custom)</strong>, <strong>earliest position (Earliest)</strong>, or <strong>latest position (Latest)</strong>.</li>\\n <li>Provides an error-handling mechanism in case of subscription failure, allowing you to re-subscribe to the channel and retrieve events from the&nbsp;<strong>earliest position (Earliest)</strong> or <strong>latest position (Latest)</strong>.</li>\\n</ul>\\n<p><strong>Documentation:</strong></p>\\n<p>All documentation, including the User Guide, and Release Notes are included in the documentation tab of this package.</p>\\n<p><strong>Download Location:</strong></p>\\n<p>&nbsp;To install the Adapter, refer to the Adapter Guide located in the Documents tab.</p>","shortText":"This package includes the SalesforcePubSub Adapter and its documentation. The SalesforcePubSub adapter is an adapter available on SAP Integration Suite that facilitates message publishing and subscription via Salesforce Pub/Sub API.","version":"1.0.0","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"p.karthikeyan@sierradigitalinc.com","creationDate":"1743166520110","modifiedDate":"1743166520116","createdBy":"p.karthikeyan@sierradigitalinc.com","products":"SalesforcePubSubAPI","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"8852ac45d3e448f39bd21c5743208802","PartnerContent":false,"UpdateAvailable":true,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'SalesforcePubSubAdapterforSAPIntegrationSuite\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"SAPBrokerReconciliationforCommodityDerivativesIntegrationwithThirdPartySystem","name":"SAP Broker Reconciliation for Commodity Derivatives Integration with Third-Party System","description":"<p>This integration package enables you to integrate security class data and position data from the system to be connected to SAP Broker Reconciliation for Commodity Derivatives for statement reconciliation. This integration is applicable for third-party systems.</p>\\n<p>The following functions are supported:&nbsp;</p>\\n<ol style=\\"list-style-type: decimal\\">\\n <li><p>Retrieve security class data from a third-party system.&nbsp;</p></li>\\n <li><p>Retrieve trading broker transactions from a third-party system.&nbsp;</p></li>\\n <li><p>Retrieve clearing broker transactions from a third-party system.&nbsp;&nbsp;</p></li>\\n <li><p>Send notifications to the configured e-mail ID in case of integration flow errors.</p></li>\\n <li><p>Transform the retrieved data to the target schema.&nbsp;</p></li>\\n <li><p>Save error logs as attachments in the Cloud Integration tenant.</p></li>\\n</ol>","shortText":"Enables integration of security class data and position data for statement reconciliation","version":"3.0.0","vendor":"SAP","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"d.malarmani@sierradigitalinc.com","creationDate":"1742903983639","modifiedDate":"1742903983644","createdBy":"d.malarmani@sierradigitalinc.com","products":"SAPBrokerReconciliationforCommodityDerivatives,SAPCloudPlatform,SAPCloudPlatformIntegration,ThirdParty","keywords":"Broker,Broker Recon,Commodity,Commodity Derivatives,Reconciliation","countries":"","industries":"Consumer Products,Oil and Gas","lineOfBusiness":"Finance","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"688d300c8c3a479495bd89dcd9de138a","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'SAPBrokerReconciliationforCommodityDerivativesIntegrationwithThirdPartySystem\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"SAPCommerceB2CIntegrationwithSAPCloudforCustomer","name":"SAP Commerce Cloud - B2C Integration with SAP Cloud for Customer","description":"<p>Integrate SAP Commerce Cloud with SAP Cloud for Customer, using a convenient solution. Enjoy a standardized integration scope with mostly pre-configured content for predictable and fast integration.</p>\\n<p>This package allows replication of registered or updated customer data from&nbsp;SAP Commerce Cloud to SAP Cloud for Customer. Following features are provided by this package:</p>\\n<ul>\\n <li>Replicate customer data from SAP Commerce Cloud to SAP Cloud for Customer</li>\\n</ul>","shortText":"Replication of customer data from SAP Commerce to SAP Cloud for Customer","version":"1.0.5","vendor":"SAP","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"m.papala@sierradigitalinc.com","creationDate":"1721324167230","modifiedDate":"1721324354268","createdBy":"m.papala@sierradigitalinc.com","products":"SAPCloudforCustomer,SAPCommerceCloud","keywords":"c4c,sap c4c,Integration,Commerce Cloud","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"c5ed7b2ab8804656a7ada7f81fc2aaf9","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'SAPCommerceB2CIntegrationwithSAPCloudforCustomer\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"SAPCloudIntegrationUtilities","name":"SAP Integration Suite Cloud Integration Utilities","description":"<p>This packages covers integration flows regarding:</p>\\n<ul>\\n <li>Notification for certificates for which the expiration date has exceeded a predefined threshold.</li>\\n <li>Notification for scenarios where no file has been picked up with an SFTP/FTP Sender Adapter.</li>\\n <li>Upload Value Mapping Entries based on JSON or XML Input.</li>\\n</ul>","shortText":"This package provides content for handling specific operational topics related to the SAP Integration Suite Cloud Integration.","version":"1.0.2","vendor":"SAP","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"r.mohan@sierradigitalinc.com","creationDate":"1752595064207","modifiedDate":"1752595064215","createdBy":"r.mohan@sierradigitalinc.com","products":"SAPCloudPlatformIntegration,SAPS4HANA,ThirdParty","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"d42388162a564f9483a578cb1aea9efb","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'SAPCloudIntegrationUtilities\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"SAPPOtoIntegrationSuite","name":"SAP_PO_to_IntegrationSuite","description":"<p></p>","shortText":"SAP PO objects Migration to CPI","version":"1.0.0","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"s.ummaka@sierradigitalinc.com","creationDate":"1721231546428","modifiedDate":"1721232216407","createdBy":"s.ummaka@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"70395f8075524009b2ae1b7470cc26e8","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'SAPPOtoIntegrationSuite\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"SAPSuccessFactorsIntegrationwithServiceNow","name":"SAP SuccessFactors Integration with ServiceNow","description":"<p>This package supports the integration of SuccessFactors with ServiceNow. It has the following integration flows:</p>\\n<p>- Integration that regularly picks changed Employee master data records (name, address, email, e.t.c) and creates users in ServiceNow.</p>\\n<p><strong>Features</strong>:</p>\\n<p>This integration flow allows replicates users from SuccessFactors to ServiceNow. The integration needs to be scheduled (if scheduled to recur) and checks for any changed or modified user data in SuccessFactors.</p>\\n<p><strong>Exception Handling</strong>:</p>\\n<p>During Integration Process, any exception raised is captured and send via email.</p>\\n<p><strong>Note</strong>:<br>This package uses basic authentication for ServiceNow. In case you prefer to use OAuth, configure ServiceNow accordingly. Details for<br>the configuration can be found in the ServiceNow adapter Guide.</p>","shortText":"This package supports the integration of SAP SuccessFactors with ServiceNow. It queries changed user records in SAP SuccessFactors and creates them in ServiceNow.","version":"1.0.1","vendor":"SAP","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"r.mohan@sierradigitalinc.com","creationDate":"1752757942491","modifiedDate":"1752757942495","createdBy":"r.mohan@sierradigitalinc.com","products":"SAPSuccessFactors,SAPSuccessFactorsEmployeeCentral,ServiceNow","keywords":"ServiceNow,Users,integration,Employee","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"beaed162c57e4121bc0e3fb636423935","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'SAPSuccessFactorsIntegrationwithServiceNow\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"SD10012Trails","name":"SD_10012_Trails","description":"<p></p>","shortText":"Trails on all the capabilities on CI & pallet operation on integration suite","version":"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"k.gopalakrishna@sierradigitalinc.com","creationDate":"1734341596671","modifiedDate":"1734341596674","createdBy":"k.gopalakrishna@sierradigitalinc.com","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"23c7bf1cd512449dabe396fa4f6317d3","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'SD10012Trails\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"ServiceNowAdapter","name":"ServiceNow Adapter for SAP Integration Suite","description":"<p><strong>Feature highlights:</strong></p>\\n<ul>\\n <li>Supports Basic and OAuth2 as authentication mechanisms to connect to ServiceNow.</li>\\n <li>Support for multiple API versions.</li>\\n <li>Supports multiple operations, including CRUD operations on ServiceNow tables.</li>\\n <li>Supports for multiple attachment operations including uploading of files.</li>\\n <li>Supports outbound headers.</li>\\n <li>Supports pagination.</li>\\n <li>Supports dynamic configuration with headers and properties.</li>\\n <li>Support for XML and JSON formats.</li>\\n <li>XSD generation: the adapter comes equipped with an Eclipse Plug-in which generates XSDs representing the object in ServiceNow.&nbsp;</li>\\n</ul>\\n<p><strong>Documentation:</strong></p>\\n<p>All documentation, including the Installation Guide, User Guide, and Release Notes are included in the documentation tab of this package.</p>\\n<p><strong>Download Location:</strong></p>\\n<p>To download the SAP ServiceNow Adapter\'s Eclipse Plug-In or Workbench, navigate to: <a href=\\"https://launchpad.support.sap.com/#/softwarecenter\\" rel=\\"nofollow\\">https://launchpad.support.sap.com/#/softwarecenter</a>&nbsp;&gt;&gt; SUPPORT PACKAGES &amp; PATCHES By Alphabetical Index (A-Z) &gt;&gt;&nbsp;C &gt;&gt;&nbsp;look for “<strong>SAP CP IS ADAPTER ADVANCE PACK</strong>”.</p>\\n<p>Alternatively, you can directly go to:</p>\\n<ul>\\n <li><a href=\\"https://eur03.safelinks.protection.outlook.com/?url=https%3A%2F%2Flaunchpad.support.sap.com%2F%23%2Fsoftwarecenter%2Ftemplate%2Fproducts%2F_APP%3D00200682500000001943%26_EVENT%3DNEXT%26HEADER%3DY%26FUNCTIONBAR%3DY%26EVENT%3DTREE%26NE%3DNAVIGATE%26ENR%3D73555000100800003071%26V%3DMAINT%26TA%3DACTUAL%2FSAP%2520CP%2520IS%2520ADAPTER%2520ADVANCE%2520PACK&amp;data=04%7C01%7Cjohn.bilay%40rojoconsultancy.com%7C514b303c7b6a4903e49708d8a0d0c4f2%7C920d0ff2113441eca952e6c5ca6532c1%7C0%7C0%7C637436165801744392%7CUnknown%7CTWFpbGZsb3d8eyJWIjoiMC4wLjAwMDAiLCJQIjoiV2luMzIiLCJBTiI6Ik1haWwiLCJXVCI6Mn0%3D%7C1000&amp;sdata=hr4z9GRGDN1%2FhvvE1i%2FmyqbGhUotS5hK%2BjtuBPejytw%3D&amp;reserved=0\\" rel=\\"nofollow\\">SAP CP IS ADAPTER ADVANCE PACK</a></li>\\n</ul>\\n<p>Please note that the content of the package is the Eclipse Plug-In or Workbench. To install the Adapter, refer to the Adapter Installation Guide located in the Documents tab.</p>\\n<p>This package is accessible to customers with an SAP Integration Suite standard and premium edition.</p>","shortText":"The ServiceNow adapter facilitates and accelerates the implementation time of connecting to ServiceNow. It provides features that reduce the complexity of discovering ServiceNow tables and their properties.","version":"1.0.4","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"d.malarmani@sierradigitalinc.com","creationDate":"1724924730252","modifiedDate":"1724924730256","createdBy":"d.malarmani@sierradigitalinc.com","products":"SAPCloudPlatformIntegration,SAPCloudPlatformIntegrationSuite,ServiceNow","keywords":"Incident,Incident Management,SNOW,Service Desk,ServiceNow","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"51772143d916449e8b5e83684eb83861","PartnerContent":false,"UpdateAvailable":true,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'ServiceNowAdapter\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"SFTPToRESTPkg","name":"SFTPToRESTPkg","description":"<p>Package for SFTP sender to REST receiver iFlow</p>","shortText":"Package for SFTP sender to REST receiver iFlow","version":"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","creationDate":"1764229660363","modifiedDate":"1764229660365","createdBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"9021383264e5462bbe0f109aa85591e7","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'SFTPToRESTPkg\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"SlackAdapterforSAPIntegrationSuite","name":"Slack Adapter for SAP Integration Suite","description":"<p><p style=\\"text-align: justify\\">Slack adapter to create or manage conversations, upload files or chats, create group, etc. within Slack channel, in order to meet the specific needs effectively and reduce the email count significantly. The adapter is available only for certain service plans of the SAP Integration Suite. For more information, see SAP Note <a href=\\"https://launchpad.support.sap.com/#/notes/3188446\\" rel=\\"nofollow\\">3188446</a></p>\\n<p style=\\"text-align: justify\\">Product Features:</p>\\n<ul style=\\"list-style-type: disc ; text-align: justify\\">\\n <li>Create or manage Slack Channels.</li>\\n <li>Post Message to a Channel.</li>\\n <li>Managing and tracking documents.</li>\\n <li>Using shared channels across workspaces.</li>\\n <li>Setting reminders.</li>\\n <li>Reacting to message on a Channel.</li>\\n <li>Create and Manage emoji.</li>\\n <li>Create Team or Get teams Information.</li>\\n <li>Create and Manage user.</li>\\n <li>Create and manage User Groups</li>\\n <li>Set user Preference.</li>\\n <li>Perform Admin Activity.</li>\\n</ul>\\n<p style=\\"text-align: justify\\">Key Features:</p>\\n<ul style=\\"list-style-type: disc\\">\\n <li style=\\"text-align: justify\\">App, Bot or User Token Based Authorization.</li>\\n <li style=\\"text-align: justify\\">Dynamic header and property support in the receiver adapter.</li>\\n <li style=\\"text-align: justify\\">Desired response type from Slack (JSON or XML).</li>\\n</ul></p>","shortText":"Slack adapter to create channel or retrieve files and folder or chats with people between slack storage and SAP Cloud Integration.","version":"1.0.2","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"p.karthikeyan@sierradigitalinc.com","creationDate":"1743765223453","modifiedDate":"1743765223465","createdBy":"p.karthikeyan@sierradigitalinc.com","products":"SAPCloudPlatformIntegration,SAPCloudPlatformIntegrationSuite,Slack","keywords":"Adapter,Adapter for SAP,Integration Suite,SAP Integration Suite,Slack,Slack Adapter,Slack Suite,Suite","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"da62a946afec40829c3b2e93dffc8a1b","PartnerContent":false,"UpdateAvailable":true,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'SlackAdapterforSAPIntegrationSuite\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"SnowflakeAdapterforSAPIntegrationSuite","name":"Snowflake Adapter for SAP Integration Suite","description":"<p>The Snowflake adapter facilitates and accelerates the implementation time of connecting to Snowflake. The adapter is available only for Standard service plans and above of the SAP Integration Suite. For more information, see SAP Note <a href=\\"https://launchpad.support.sap.com/#/notes/3188446\\" rel=\\"nofollow\\">3188446</a>.&nbsp;</p>\\n<p><strong>Feature highlights:</strong></p>\\n<ul>\\n <li><strong>Bulk Export and Import:</strong> Supports reading files from multiple input formats like CSV, JSON, and Avro. Export data to your desired format using <strong>unload</strong> operation.</li>\\n <li><strong>Snowflake Operations Suppor</strong>t: Snowflake Adapter offers support for all Snowflake operations along with extended SQL support for advanced users.</li>\\n <li><strong>Ease of Access and Connectivity</strong> : Snowflake adapter allows you to save connection related details on our platform which simplifies operations and querying on your part.</li>\\n <li><strong>Multiple options for Staging Storage:</strong> Snowflake Adapter provides various options to load data into <strong>staging</strong> storage like Amazon S3, Google Cloud Storage, or Microsoft Azure.</li>\\n <li><strong>Secure Authentication:</strong> Provides secure authentication with <strong>Database Account</strong> and<strong> Key-Pair</strong> options.</li>\\n</ul>\\n<p><strong>Documentation:</strong></p>\\n<p>All documentation, including the User Guide, and Release Notes are included in the documentation tab of this package.</p>\\n<p><strong>Download Location:</strong></p>\\n<p>&nbsp;To install the Adapter, refer to the Adapter Guide located in the Documents tab.</p>","shortText":"This package includes the Snowflake Adapter and its documentation. The Snowflake adapter facilitates and accelerates the implementation time of connecting to Snowflake.","version":"1.1.1","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"SYSTEM","creationDate":"1738744442263"