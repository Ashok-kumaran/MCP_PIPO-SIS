m","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"094114ac6b1949deb656a61e9d0d81d2","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'EventMeshPOCDhinesh\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"FileToRestPkg","name":"FileToRestPkg","description":"<p>SFTP to REST simple flow</p>","shortText":"SFTP to REST simple flow","version":"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","creationDate":"1764226675899","modifiedDate":"1764226675901","createdBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"9d27fd6aea684440a8f14256bc15ff8d","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'FileToRestPkg\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"GenericIFlowPkg","name":"GenericIFlowPkg","description":"<p>Generic package for iFlow creation</p>","shortText":"Generic package for iFlow creation","version":"","vendor":"","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","creationDate":"1764232343852","modifiedDate":"1764232343854","createdBy":"sb-e2cce3d6-d9ac-4b86-90c1-36b5b1cf747b!b183067|it!b56186","products":"","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"027beeb18f4341e3814f8561d76d524c","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'GenericIFlowPkg\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"GooglePubSubAdapterforSAPIntegrationSuite","name":"Google Pub/Sub Adapter for SAP Integration Suite","description":"<p>The GooglePubSub adapter facilitates and accelerates the implementation time of connecting to Google Pub/Sub. The adapter is available only for Standard service plans and above of the SAP Integration Suite. For more information, see SAP Note <a href=\\"https://launchpad.support.sap.com/#/notes/3188446\\" rel=\\"nofollow\\">3188446</a>.</p>\\n<ul>\\n <li>Receiver adapter allows reliable <strong>publishing</strong> of messages to Google Pub/Sub. It offers single message (<strong>Basic</strong>) and multiple message publishing<strong> </strong>(<strong>Advanced</strong>) capabilities.</li>\\n <li>Support for listing Topics with&nbsp;<strong>pagination</strong> using <strong>Page Token.</strong></li>\\n <li>Allows you to modify the acknowledgement deadline of a message using the <strong>Modify Acknowledgement Deadline </strong>operation<strong>.</strong></li>\\n <li>Sender adapter allows&nbsp;<strong>consuming</strong> messages from Google Pub/Sub. You can read messages in real time <strong>(gRPC)</strong> or using a specified polling interval <strong>(REST)</strong>.</li>\\n <li>Provides&nbsp;<strong>multiple post-processing </strong>options: <em>Acknowledge after Successful Processing</em>, <em>Acknowledge Immediately</em>, and <em>Do not Acknowledge</em>.</li>\\n <li>Offers secure authentication via&nbsp;<strong>OAuth2 Service Account </strong>option which uses Key Pair authentication.</li>\\n</ul>\\n<p><strong>Documentation:</strong></p>\\n<p>All documentation, including the User Guide, and Release Notes are included in the documentation tab of this package.</p>\\n<p><strong>Download Location:</strong></p>\\n<p>&nbsp;To install the Adapter, refer to the Adapter Guide located in the Documents tab.</p>","shortText":"This package includes the GooglePubSub Adapter and its documentation. The GooglePubSub adapter is an adapter available on SAP Integration Suite that facilitates message publishing and subscription via Google Pub/Sub.","version":"1.0.0","vendor":"SAP","mode":"READ_ONLY","supportedPlatform":"Cloud Integration","modifiedBy":"s.ramkumar@sierradigitalinc.com","creationDate":"1746182715596","modifiedDate":"1746182715608","createdBy":"s.ramkumar@sierradigitalinc.com","products":"GoogleCloudPubSub","keywords":"","countries":"","industries":"","lineOfBusiness":"","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"917753da76fe44f5a392e8cf369d0a2c","PartnerContent":false,"UpdateAvailable":true,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'GooglePubSubAdapterforSAPIntegrationSuite\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"IntegrationSuiteAlertingFrameworkusingAlertNotificationService","name":"Integration Suite Alerting Framework using SAP BTP Alert Notification Service","description":"<p>This package contains multiple iflows designed to extract and send cloud integration events to SAP BTP Alert Notification Service as below<br><br>\\n 1 - Send Events to ANS<br>\\n 2 - Send Cloud Integration Error iflows events to ANS<br>\\n 3 - Send Cloud Integration Error Messages events to ANS<br>\\n 4 - Send Cloud Integration JMS events to ANS<br>\\n 5 - Send Cloud Integration Expiring Certificates events to ANS<br>\\n 6 - Send Explicit (Exception/Notification) Events to ANS<br><br><br>\\n More information on <a href=\\"https://help.sap.com/docs/alert-notification/sap-alert-notification-for-sap-btp/what-is-sap-alert-notification-service-for-sap-btp?locale=en-US\\" rel=\\"nofollow\\">SAP Alert Notification Service for SAP BTP </a></p>","shortText":"This package includes various iflows to relay events on message failures, erroring iflows, expiring/expired certificates, JMS queue issues, etc., by utilizing Message Processing Log APIs to send notifications through SAP BTP Alert Notification Service.","version":"1.0.0","vendor":"SAP","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"s.shaik@sierradigitalinc.com","creationDate":"1747220587999","modifiedDate":"1747220588005","createdBy":"s.shaik@sierradigitalinc.com","products":"SAPCloudPlatformAlertNotification,SAPCloudPlatformIntegration","keywords":"","countries":"","industries":"","lineOfBusiness":"Technology Area Enterprise Technology","integrationDesigntimeArtifacts":[],"valueMappingDesigntimeArtifacts":[],"messageMappingDesigntimeArtifacts":[],"customTags":[],"ResourceId":"d7280ee40b144404b62ae2dfe81bbe19","PartnerContent":false,"UpdateAvailable":false,"PackageContent":null,"ScriptCollectionDesigntimeArtifacts":{"__deferred":{"uri":"https://hess-test-btdpygoi.it-cpi019.cfapps.us10-002.hana.ondemand.com:443/api/v1/IntegrationPackages(\'IntegrationSuiteAlertingFrameworkusingAlertNotificationService\')/ScriptCollectionDesigntimeArtifacts"}}},{"id":"INVOIC02TOINVOIC96Amigration","name":"INVOIC02_TO_INVOIC96A_migration","description":"<p></p>","shortText":"Migrating PIPO interface to CPI","version":"1.0.1","vendor":"SAP","mode":"EDIT_ALLOWED","supportedPlatform":"Cloud Integration","modifiedBy":"s.shaik@sierradigitalinc.com","creationDate":"1760437783395","modifiedDate":"1760437783398","createdBy":"s.shaik@sierradigitalinc.com","products":"","keywords":"","countr