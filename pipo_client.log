ation>Key for external message archive</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:maxLength value="70"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="SERIAL" minOccurs="0">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Serialization</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:maxLength value="20"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n         </xsd:sequence>\r\n         <xsd:attribute name="SEGMENT" use="required">\r\n          <xsd:simpleType>\r\n           <xsd:restriction base="xsd:string">\r\n            <xsd:enumeration value="1"/>\r\n           </xsd:restriction>\r\n          </xsd:simpleType>\r\n         </xsd:attribute>\r\n        </xsd:complexType>\r\n       </xsd:element>\r\n       <xsd:element name="E1MDSTL" maxOccurs="999999">\r\n        <xsd:annotation>\r\n         <xsd:documentation>Master Material Stock (MDSTA)</xsd:documentation>\r\n        </xsd:annotation>\r\n        <xsd:complexType>\r\n         <xsd:sequence>\r\n          <xsd:element name="MATNR" minOccurs="0">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Material Number (18 Characters)</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:maxLength value="18"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="WERKS" minOccurs="0">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Plant</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:maxLength value="4"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="PLSCN" minOccurs="0">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Planning Scenario in Long-Term Planning</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:pattern value="\\d+"/>\r\n             <xsd:maxLength value="3"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="EINME" minOccurs="0">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Total Stock of All Restricted Batches</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:maxLength value="15"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="EISBE" minOccurs="0">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Safety Stock</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:maxLength value="14"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="INSME" minOccurs="0">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Stock in Quality Inspection</xsd:documentation>\r\n           </xsd:annotation>\r\n           <xsd:simpleType>\r\n            <xsd:restriction base="xsd:string">\r\n             <xsd:maxLength value="15"/>\r\n            </xsd:restriction>\r\n           </xsd:simpleType>\r\n          </xsd:element>\r\n          <xsd:element name="KEINM" minOccurs="0">\r\n           <xsd:annotation>\r\n            <xsd:documentation>Restricte