<?xml version="1.0" encoding="UTF-8"?>
<if:IntegrationFlow xmlns:if="http://www.sap.com/it/rt/integrationflow" id="OrderSync5" name="OrderSync5" package="mcppipo" description="Receive HTTPS JSON, convert to XML, call S/4HANA OData to create Sales Order, and return JSON response">
  <if:Sender id="Sender_HTTP" name="HTTPS Sender">
    <if:Adapter type="http" subtype="http-server" id="HTTP_Sender_Adapter">
      <if:Connection>
        <if:Address path="${http.path}"/>
        <if:Method>POST</if:Method>
        <if:UseSSL>true</if:UseSSL>
      </if:Connection>
      <if:Runtime>
        <if:AllowedMethods>POST</if:AllowedMethods>
        <if:ContentType>application/json</if:ContentType>
      </if:Runtime>
    </if:Adapter>
  </if:Sender>
  <if:Process id="Process_Main" name="Main Process">
    <if:Steps>
      <if:JsonToXml id="Step_JsonToXml" name="JSON to XML"/>
      <if:MessageTransform id="Step_XSLT" name="Build OData Create Payload" resource="scripts/JsonXml_to_ODataCreate.xsl"/>
      <if:RequestReply id="Step_RequestReply_OData" name="Create Sales Order in S/4HANA">
        <if:ReceiverRef ref="Receiver_S4"/>
      </if:RequestReply>
      <if:GroovyScript id="Step_BuildSuccessResponse" name="Build Success JSON" resource="scripts/BuildSuccessResponse.groovy"/>
    </if:Steps>
  </if:Process>
  <if:ExceptionSubprocess id="Exception_Subprocess" name="On Exception">
    <if:StartEvent error="*"/>
    <if:GroovyScript id="Step_ErrorJson" name="Build Error JSON" resource="scripts/BuildErrorResponse.groovy"/>
    <if:EndEvent/>
  </if:ExceptionSubprocess>
  <if:Receiver id="Receiver_S4" name="S/4HANA OData">
    <if:Adapter type="odatav2" id="ODataV2_Receiver_Adapter">
      <if:Connection>
        <if:ServiceUrl host="${s4.host}" servicePath="${s4.servicePath}"/>
        <if:EntitySet>${odata.entitySet}</if:EntitySet>
        <if:Operation>CREATE</if:Operation>
        <if:QueryParameters>sap-client=${s4.client}</if:QueryParameters>
      </if:Connection>
      <if:Runtime>
        <if:ContentType>application/xml</if:ContentType>
      </if:Runtime>
      <if:Security>
        <if:CredentialAlias>${s4.credentialAlias}</if:CredentialAlias>
      </if:Security>
    </if:Adapter>
  </if:Receiver>
  <if:Endpoints>
    <if:HttpEndpoint method="POST" path="${http.path}"/>
  </if:Endpoints>
</if:IntegrationFlow>
